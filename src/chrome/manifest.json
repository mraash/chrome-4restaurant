{
    "manifest_version": 3,
    "name": "4Restaurant",
    "version": "1.0.0",
    "description": "Helper extension for the 4Restaurant restaurant management system.",
    "permissions": [
        "contextMenus",
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "file:///*"
    ],
    "background": {
        "service_worker": "service-worker.js"
    },
    "content_scripts": [
        {
            "matches": [
                "file:///*"
            ],
            "js": [
                "content-script.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "options_page": "options.html",
    "action": {
        "default_title": "4Restaurant"
    }
}
